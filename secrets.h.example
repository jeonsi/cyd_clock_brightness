// OPTIONAL: Wi-Fi is normally configured on the device itself (scan +
// on-screen keyboard, stored in NVS). Copy this file to secrets.h only if
// you want compile-time fallback credentials for the very first boot.
#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"

#endif
